{
  "listeners": [
    {
      "kind": "tcp",
      "addr": "127.0.0.1:18080"
    }
  ],
  "threads": 1,
  "workStealing": false,
  "workerTransport": {
    "kind": "unix"
  },
  "workers": [
    {
      "name": "api-worker",
      "main": "./handlers/api.ts",
      "matcher": {
        "rule": "PathPrefix('/api')",
        "priority": 50
      },
      "permissions": {
        "read": true,
        "env": [
          "ROLE"
        ]
      },
      "env": {
        "ROLE": "api"
      },
      "lazy": false,
      "replicas": 2
    },
    {
      "name": "static-worker",
      "main": "./handlers/static.ts",
      "matcher": {
        "rule": "PathPrefix('/static')",
        "priority": 40
      },
      "permissions": {
        "read": true,
        "env": [
          "ROLE"
        ]
      },
      "env": {
        "ROLE": "static"
      },
      "lazy": true
    }
  ],
  "loadBalancer": {
    "algorithm": "round_robin"
  }
}
